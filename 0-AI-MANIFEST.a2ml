; 0-AI-MANIFEST — root entry point for the a2ml-ecosystem coordination hub.
; This hub is a SATELLITE of hyperpolymath/standards. It does not own the
; A2ML specification or governance; it pins them from standards by tag and
; owns conformance fixtures, the membership manifest, and cross-repo drift CI.
;
; Machine-readable coordination metadata lives under .machine_readable/ ONLY.
(ai-manifest
  (repository "hyperpolymath/a2ml-ecosystem")
  (role "coordination-hub")
  (semantic-authority "satellite")
  (upstream "hyperpolymath/standards")
  (machine-readable
    (anchor ".machine_readable/anchors/ANCHOR.a2ml")
    (ecosystem ".machine_readable/6a2/ECOSYSTEM.a2ml")
    (state ".machine_readable/6a2/STATE.a2ml")
    (meta ".machine_readable/6a2/META.a2ml")
    (playbook ".machine_readable/6a2/PLAYBOOK.a2ml")
    (agentic ".machine_readable/6a2/AGENTIC.a2ml")
    (neurosym ".machine_readable/6a2/NEUROSYM.a2ml"))
  (owned-here
    (conformance "conformance/")
    (membership ".machine_readable/6a2/ECOSYSTEM.a2ml")
    (drift-ci ".github/workflows/anchor-drift.yml"))
  (not-owned-here
    (spec (repo "hyperpolymath/a2ml") (path "SPEC.adoc") (pin "75704e4cac33bd11db32958fdc7e0ae4ec916b39"))
    (spec-record-dialect (repo "hyperpolymath/a2ml") (path "RECORD-DIALECT-SPEC.adoc") (pin "75704e4cac33bd11db32958fdc7e0ae4ec916b39"))
    (spec-manifest-dialect (repo "hyperpolymath/a2ml") (path "MANIFEST-DIALECT-SPEC.adoc") (pin "75704e4cac33bd11db32958fdc7e0ae4ec916b39"))
    (governance (repo "hyperpolymath/standards") (path "GOVERNANCE.adoc") (pin "0ef5917b3a6742dc69b6758b3e40a7beb8b97d04")))
  (entrypoints
    (human "README.adoc")
    (roadmap "ROADMAP.adoc")
    (close-out "CLOSE-OUT.md")))
